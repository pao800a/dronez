{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv tree*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git tag *)",
      "Bash(gh *)",
      "Bash(pytest*)",
      "mcp__context7__*",
      "mcp__dronez-sim__*",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__create_pull_request",
      "mcp__github__create_branch",
      "mcp__github__create_issue",
      "mcp__github__add_issue_comment",
      "mcp__github__update_pull_request"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_bash.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_edit.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit_ruff.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_pytest.py"
            ],
            "timeout": 150
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent_log.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent_log.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_compact.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
